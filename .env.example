# Current supported runtime config.
# Copy this file to .env and fill in values when you want to call a real LLM.

# Use "mock" to keep local fallback behavior.
# Use "openai" or another OpenAI-compatible provider name to enable remote chat completions.
LLM_PROVIDER=mock

# Example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=your_api_key
# LLM_BASE_URL=https://api.openai.com/v1

LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
